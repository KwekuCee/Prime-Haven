{
  "name": "prime-haven-workspace",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "artifacts/prime-haven/node_modules/.bin/vite --config artifacts/prime-haven/vite.config.ts --host 0.0.0.0 --port 3000",
    "build": "node artifacts/prime-haven/node_modules/vite/bin/vite.js build --config artifacts/prime-haven/vite.config.ts",
    "copy:dist": "node -e \"const fs=require('fs'); fs.rmSync('dist', { recursive: true, force: true }); fs.cpSync('artifacts/prime-haven/dist', 'dist', { recursive: true });\"",
    "build:dev": "npm run build",
    "serve": "artifacts/prime-haven/node_modules/.bin/vite preview --config artifacts/prime-haven/vite.config.ts --host 0.0.0.0 --port 3000",
    "typecheck": "artifacts/prime-haven/node_modules/.bin/tsc -p artifacts/prime-haven/tsconfig.json --noEmit",
    "lint": "artifacts/prime-haven/node_modules/.bin/tsc -p artifacts/prime-haven/tsconfig.json --noEmit"
  },
  "workspaces": [
    "artifacts/prime-haven"
  ],
  "devDependencies": {
    "drizzle-kit": "0.x",
    "drizzle-orm": "0.x",
    "postgres": "^3.4.9"
  }
}
