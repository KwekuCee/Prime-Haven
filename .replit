modules = ["nodejs-24"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[workflows]

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[[ports]]
localPort = 5000
externalPort = 5000

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 21106
externalPort = 80
